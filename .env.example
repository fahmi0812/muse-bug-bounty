# .env.example — CONTOH SAJA, tanpa secret asli.
# Salin ke .env lalu isi dengan nilai sendiri. JANGAN commit .env.
# Semua nilai di bawah ini placeholder REPLACE-ME / contoh palsu.

# --- Provider LLM (Mode 2 Standalone saja; Mode 1 Muse tidak butuh) ---
# Tipe: openai | anthropic
LLM_PROVIDER=REPLACE-ME
LLM_API_BASE=https://example.invalid/v1
LLM_API_KEY=REPLACE-ME
LLM_MODEL=REPLACE-ME

# --- 9router lokal (opsional, contoh alamat lokal) ---
NINEROUTER_BASE_URL=http://127.0.0.1:20128
NINEROUTER_API_KEY=REPLACE-ME

# --- Lab eval / PentAGI P2 (opsional, placeholder saja) ---
POSTGRES_PASSWORD=REPLACE-ME
NEO4J_PASSWORD=REPLACE-ME
LANGFUSE_SECRET=REPLACE-ME
LANGFUSE_SALT=REPLACE-ME
GRAFANA_PASSWORD=REPLACE-ME

# --- MCP platform baca-saja (P2, opsional, tanpa auto-submit) ---
HACKERONE_API_TOKEN=REPLACE-ME
BUGCROWD_API_TOKEN=REPLACE-ME
INTIGRITI_API_TOKEN=REPLACE-ME

# --- MobSF (P2, opsional) ---
MOBSF_API_KEY=REPLACE-ME
MOBSF_URL=http://127.0.0.1:8000

# --- Batas default (jangan naikkan diam-diam, lihat docs/TEAM.md) ---
BOUNTY_MAX_BUDGET_USD=5
BOUNTY_RATE_LIMIT_PER_SECOND=10
BOUNTY_DOCKER=0
